<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="secretchat.chat.controller.MessageActionDialogController"
      stylesheets="@../css/dialog-common.css"
      styleClass="dialog-root"
      spacing="0"
      prefWidth="440">

    <!-- HEADER -->
    <HBox styleClass="dialog-header" alignment="CENTER_LEFT" spacing="12">
        <padding>
            <Insets top="22" right="24" bottom="22" left="24"/>
        </padding>

        <Label fx:id="iconLabel" text="⚙️" style="-fx-font-size: 22px;"/>

        <VBox spacing="2">
            <Label fx:id="titleLabel" text="Xác nhận" styleClass="dialog-title"/>
        </VBox>
    </HBox>

    <!-- BODY -->
    <VBox spacing="16" styleClass="dialog-body">
        <padding>
            <Insets top="24" right="24" bottom="8" left="24"/>
        </padding>

        <Label fx:id="messageLabel" text="Bạn có chắc chắn muốn thực hiện hành động này?" styleClass="field-label" wrapText="true"/>
    </VBox>

    <!-- FOOTER -->
    <HBox spacing="12" alignment="CENTER_RIGHT" styleClass="dialog-footer">
        <padding>
            <Insets top="20" right="24" bottom="24" left="24"/>
        </padding>

        <Button text="Huỷ"
                onAction="#handleCancel"
                styleClass="cancel-btn"/>

        <Button fx:id="confirmButton" text="Xác nhận"
                onAction="#handleConfirm"
                styleClass="primary-btn"
                defaultButton="true"/>
    </HBox>

</VBox>
