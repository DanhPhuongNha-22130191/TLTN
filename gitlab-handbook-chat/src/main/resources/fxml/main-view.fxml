<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="secretchat.chat.controller.MainController"
      alignment="CENTER"
      spacing="30"
      prefWidth="1200"
      prefHeight="800"
      styleClass="root"
      stylesheets="@../css/register.css">

    <VBox alignment="CENTER" spacing="10" style="-fx-background-color: white; -fx-padding: 50; -fx-background-radius: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 30, 0.16, 0, 8);">
        <StackPane styleClass="logo-box" style="-fx-background-color: #6a8dff;">
            <Label text="S" styleClass="logo-text"/>
        </StackPane>
        <Label text="Chào mừng bạn đến với The GitLab Handbook Chat!" styleClass="form-title" style="-fx-font-size: 32px;"/>
        <Label text="Kết nối an toàn, bảo mật và cực kỳ nhanh chóng." styleClass="form-caption"/>
        
        <Separator prefWidth="300" style="-fx-padding: 20 0 20 0;"/>
        
        <Button text="Đăng xuất"
                onAction="#handleLogout"
                styleClass="primary-btn"
                prefWidth="200"
                style="-fx-background-color: #ff4d6d;"/>
    </VBox>

</VBox>
