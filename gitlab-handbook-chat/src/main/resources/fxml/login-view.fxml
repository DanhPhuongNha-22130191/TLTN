<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="secretchat.auth.controller.LoginController"
      spacing="0"
      prefWidth="1100"
      prefHeight="700"
      styleClass="root"
      stylesheets="@../css/register.css">

    <!-- ================= LEFT ================= -->
    <VBox fx:id="leftPanel"
          HBox.hgrow="ALWAYS"
          alignment="CENTER"
          spacing="24"
          styleClass="left-panel">

        <StackPane styleClass="logo-box">
            <Label text="G" styleClass="logo-text"/>
        </StackPane>

        <VBox alignment="CENTER" spacing="10">
            <Label text="The GitLab Handbook Chat" styleClass="hero-title"/>
            <Label text="Private • Secure • Fast" styleClass="hero-subtitle"/>
        </VBox>

        <fx:include source="connection-status.fxml"/>

    </VBox>

    <!-- ================= RIGHT ================= -->
    <StackPane fx:id="rightPanel"
               HBox.hgrow="ALWAYS"
               alignment="CENTER"
               styleClass="right-panel">

        <ScrollPane fitToWidth="true"
                    fitToHeight="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    styleClass="form-scroll">

            <VBox alignment="CENTER">

                <VBox spacing="14"
                      styleClass="form-card">

                    <!-- TITLE -->
                    <VBox spacing="4">
                        <Label text="Đăng nhập tài khoản"
                               styleClass="form-title"/>

                        <Label text="Đăng nhập để vào chat ngay thôi!"
                               styleClass="form-caption"/>
                    </VBox>


                    <!-- USERNAME -->
                    <VBox spacing="5">
                        <Label text="Tên đăng nhập"
                               styleClass="field-label"/>

                        <TextField fx:id="usernameField"
                                   promptText="Nhập tên đăng nhập"
                                   styleClass="input-field"/>

                        <Label fx:id="usernameError"
                               styleClass="error-label"
                               visible="false"
                               managed="false"/>
                    </VBox>


                    <!-- PASSWORD -->
                    <VBox spacing="5">
                        <Label text="Mật khẩu"
                               styleClass="field-label"/>

                        <HBox spacing="8"
                              alignment="CENTER_LEFT">

                            <StackPane HBox.hgrow="ALWAYS">

                                <PasswordField fx:id="passwordField"
                                               promptText="Nhập mật khẩu"
                                               styleClass="input-field"/>

                                <TextField fx:id="passwordTextField"
                                           promptText="Nhập mật khẩu"
                                           styleClass="input-field"
                                           visible="false"
                                           managed="false"/>
                            </StackPane>

                            <Button fx:id="togglePasswordBtn"
                                    text="Show"
                                    onAction="#togglePasswordVisibility"
                                    styleClass="toggle-btn"/>
                        </HBox>

                        <Label fx:id="passwordError"
                               styleClass="error-label"
                               visible="false"
                               managed="false"/>

                        <Button text="Quên mật khẩu?"
                                onAction="#handleForgotPassword"
                                styleClass="forgot-password-btn"/>
                    </VBox>


                    <!-- TERMS -->
                    <VBox fx:id="termsCheckBox"
                              styleClass="terms-checkbox"/>

                    <!-- GLOBAL MESSAGE -->
                    <Label fx:id="lblMessage"
                           wrapText="true"
                           visible="false"
                           managed="false"
                           styleClass="message-label"/>

                    <!-- LOGIN BUTTON -->
                    <Button fx:id="registerButton"
                            text="Đăng nhập tài khoản"
                            prefHeight="48"
                            maxWidth="Infinity"
                            onAction="#handleLogin"
                            styleClass="primary-btn"/>

                    <!-- LOADING -->
                    <HBox fx:id="loadingBox"
                          alignment="CENTER"
                          spacing="8"
                          visible="false"
                          managed="false">

                        <ProgressIndicator prefWidth="18"
                                           prefHeight="18"/>

                        <Label text="Đang xử lý..."
                               styleClass="loading-label"/>
                    </HBox>

                    <!-- LOGIN -->
                    <HBox alignment="CENTER"
                          spacing="6">

                        <Label text="Chưa có tài khoản?"
                               styleClass="login-hint"/>

                        <Button fx:id="goToLoginBtn"
                                text="Đăng ký"
                                onAction="#goToRegister"
                                styleClass="link-btn"/>
                    </HBox>

                </VBox>

            </VBox>

        </ScrollPane>

    </StackPane>

</HBox>
