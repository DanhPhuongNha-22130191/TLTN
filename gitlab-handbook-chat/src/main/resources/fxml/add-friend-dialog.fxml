<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="secretchat.chat.controller.AddFriendController"
      stylesheets="@../css/add-friend-dialog.css"
      styleClass="dialog-root"
      spacing="0"
      prefWidth="440">

    <!-- HEADER -->
    <HBox styleClass="dialog-header" alignment="CENTER_LEFT" spacing="12">
        <padding>
            <Insets top="22" right="24" bottom="22" left="24"/>
        </padding>

        <Label text="🤝" style="-fx-font-size: 22px;"/>

        <VBox spacing="2">
            <Label text="Thêm bạn" styleClass="dialog-title"/>
            <Label text="Nhập username để thêm bạn mới" styleClass="dialog-caption"/>
        </VBox>
    </HBox>

    <!-- BODY -->
    <VBox spacing="16" styleClass="dialog-body">
        <padding>
            <Insets top="24" right="24" bottom="8" left="24"/>
        </padding>

        <VBox spacing="6">
            <Label text="Username" styleClass="field-label"/>
            <TextField fx:id="usernameField"
                       promptText="Nhập username..."
                       styleClass="input-field"/>
            <Label fx:id="errorLabel"
                   text=""
                   styleClass="error-label"
                   visible="false"
                   managed="false"/>
        </VBox>
    </VBox>

    <!-- FOOTER -->
    <HBox spacing="12" alignment="CENTER_RIGHT" styleClass="dialog-footer">
        <padding>
            <Insets top="20" right="24" bottom="24" left="24"/>
        </padding>

        <Button text="Huỷ"
                onAction="#handleCancel"
                styleClass="cancel-btn"/>

        <Button text="Thêm bạn"
                onAction="#handleAddFriend"
                styleClass="primary-btn"
                defaultButton="true"/>
    </HBox>

</VBox>
