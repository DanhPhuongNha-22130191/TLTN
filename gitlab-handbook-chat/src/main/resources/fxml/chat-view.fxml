<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="secretchat.chat.controller.ChatController"
            stylesheets="@../css/chat.css"
            prefWidth="1200"
            prefHeight="700"
            styleClass="app-root">

    <!-- ═══════════════════════════════════════
         LEFT SIDEBAR
    ════════════════════════════════════════ -->
    <left>
        <VBox prefWidth="300"
              spacing="12"
              styleClass="sidebar">

            <padding>
                <Insets top="24" right="16" bottom="20" left="16"/>
            </padding>

            <!-- Title -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <FontIcon iconLiteral="fa-comments"
                          styleClass="sidebar-title-icon"/>
                <Label text="Chat"
                       styleClass="sidebar-title">
                    <font><Font size="20"/></font>
                </Label>
            </HBox>

            <!-- Action buttons -->
            <HBox spacing="8" styleClass="sidebar-actions">
                <Button text="Tạo nhóm"
                        maxWidth="Infinity"
                        HBox.hgrow="ALWAYS"
                        onAction="#handleCreateGroup"
                        styleClass="sidebar-action-button, primary-button">
                    <graphic>
                        <FontIcon iconLiteral="fa-plus"
                                  styleClass="btn-icon"/>
                    </graphic>
                </Button>

                <Button 
                        maxWidth="Infinity"
                        HBox.hgrow="ALWAYS"
                        onAction="#handleAddFriend"
                        styleClass="sidebar-action-button, secondary-button">
                    <graphic>
                        <FontIcon iconLiteral="fa-user-plus"
                                  styleClass="btn-icon"/>
                    </graphic>
                </Button>

                <Button 
                        maxWidth="Infinity"
                        HBox.hgrow="ALWAYS"
                        onAction="#handleProfile"
                        styleClass="sidebar-action-button, secondary-button">
                    <graphic>
                        <FontIcon iconLiteral="fa-user"
                                  styleClass="btn-icon"/>
                    </graphic>
                </Button>
            </HBox>

            <!-- Search -->
            <HBox alignment="CENTER_LEFT"
                  spacing="0"
                  styleClass="search-box">
                <FontIcon iconLiteral="fa-search"
                          styleClass="search-icon"/>
                <TextField fx:id="searchField"
                           promptText="Tìm kiếm bạn bè, nhóm..."
                           onKeyReleased="#handleSearch"
                           styleClass="search-field"
                           HBox.hgrow="ALWAYS"/>
            </HBox>

            <!-- Tabs -->
            <TabPane fx:id="chatTabPane"
                     VBox.vgrow="ALWAYS"
                     tabClosingPolicy="UNAVAILABLE"
                     styleClass="chat-tab-pane">
                <tabs>
                    <Tab text="Cá nhân">
                        <ListView fx:id="privateChatList"
                                  onMouseClicked="#handleSelectPrivateChat"
                                  styleClass="conv-list"/>
                    </Tab>
                    <Tab text="Nhóm">
                        <ListView fx:id="groupChatList"
                                  onMouseClicked="#handleSelectGroupChat"
                                  styleClass="conv-list"/>
                    </Tab>
                </tabs>
            </TabPane>

            <!-- AI Assistant Button -->
            <Button fx:id="aiAssistantButton"
                    text="TRỢ LÝ AI"
                    maxWidth="Infinity"
                    onAction="#handleSelectAIAssistant"
                    styleClass="ai-assistant-button">
                <graphic>
                    <FontIcon iconLiteral="fa-magic"
                              styleClass="btn-icon"/>
                </graphic>
            </Button>

        </VBox>
    </left>

    <!-- ═══════════════════════════════════════
         CENTER — CHAT PANEL
    ════════════════════════════════════════ -->
    <center>
        <BorderPane styleClass="chat-area">

            <!-- HEADER -->
            <top>
                <HBox alignment="CENTER_LEFT"
                      spacing="14"
                      styleClass="chat-header">
                    <padding>
                        <Insets top="14" right="22" bottom="14" left="22"/>
                    </padding>

                    <!-- Clickable Profile Header Container -->
                    <HBox fx:id="chatHeaderInfoContainer"
                          alignment="CENTER_LEFT"
                          spacing="14"
                          styleClass="chat-header-info-container">
                        <!-- Avatar placeholder -->
                        <StackPane styleClass="header-avatar">
                            <FontIcon iconLiteral="fa-user"
                                      styleClass="header-avatar-icon"/>
                        </StackPane>

                        <VBox spacing="3">
                            <Label fx:id="chatTitleLabel"
                                   text="Chọn cuộc trò chuyện"
                                   styleClass="chat-title">
                                <font><Font size="17"/></font>
                            </Label>
                            <HBox alignment="CENTER_LEFT" spacing="6">
                                <FontIcon iconLiteral="fa-circle"
                                          styleClass="online-dot"/>
                                <Label fx:id="chatStatusLabel"
                                       text="Cá nhân / Nhóm"
                                       styleClass="chat-subtitle"/>
                            </HBox>
                        </VBox>
                    </HBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button text="Đăng xuất"
                            onAction="#handleLogout"
                            styleClass="ghost-button">
                        <graphic>
                            <FontIcon iconLiteral="fa-sign-out"
                                      styleClass="btn-icon"/>
                        </graphic>
                    </Button>
                </HBox>
            </top>

            <center>
                <VBox fx:id="chatContentArea">
                    <VBox spacing="5" styleClass="conversation-search-panel">
                        <HBox alignment="CENTER_LEFT" spacing="8" styleClass="conversation-search-bar">
                            <FontIcon iconLiteral="fa-search" styleClass="conversation-search-icon"/>
                            <TextField fx:id="messageSearchField"
                                       promptText="Tìm trong cuộc trò chuyện..."
                                       onAction="#handleSearchMessages"
                                       styleClass="conversation-search-field"
                                       HBox.hgrow="ALWAYS"/>
                            <Button text="Tìm" onAction="#handleSearchMessages"
                                    styleClass="conversation-search-button"/>
                        </HBox>
                        <Label fx:id="searchResultLabel"
                               visible="false" managed="false"
                               styleClass="conversation-search-result"/>
                    </VBox>

                    <VBox fx:id="pinnedArea" visible="false" managed="false" styleClass="pinned-area">
                        <HBox alignment="CENTER_LEFT" styleClass="pinned-header">
                            <Label fx:id="pinnedTitleLabel"
                                   text="Danh sách ghim (0)"
                                   styleClass="pinned-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="pinnedCollapseButton"
                                    text="Thu gọn"
                                    onAction="#handleTogglePinned"
                                    styleClass="pinned-collapse-button"/>
                        </HBox>
                    </VBox>

                    <StackPane VBox.vgrow="ALWAYS">
                        <ScrollPane fx:id="messageScrollPane"
                                    fitToWidth="true"
                                    styleClass="message-scroll">
                            <content>
                                <VBox fx:id="messageContainer"
                                      spacing="10"
                                      styleClass="message-container">
                                    <padding>
                                        <Insets top="18" right="22" bottom="18" left="22"/>
                                    </padding>
                                </VBox>
                            </content>
                        </ScrollPane>
                        <StackPane fx:id="pinnedContent"
                                   visible="false"
                                   managed="false"
                                   minHeight="116"
                                   prefHeight="116"
                                   maxHeight="116"
                                   StackPane.alignment="TOP_CENTER"
                                   styleClass="pinned-overlay">
                            <ListView fx:id="pinnedMessageList"
                                      minHeight="116"
                                      prefHeight="116"
                                      maxHeight="116"
                                      styleClass="panel-list, pinned-message-list"/>
                            <Label fx:id="pinnedEmptyLabel"
                                   text="Chưa có tin nhắn ghim"
                                   styleClass="pinned-empty"/>
                            <StackPane.margin>
                                <Insets right="14" left="14"/>
                            </StackPane.margin>
                        </StackPane>
                        <Button fx:id="scrollBottomButton"
                                text="↓"
                                visible="false"
                                managed="false"
                                onAction="#handleScrollToBottom"
                                StackPane.alignment="BOTTOM_RIGHT"
                                styleClass="scroll-bottom-button">
                            <StackPane.margin>
                                <Insets right="24" bottom="18"/>
                            </StackPane.margin>
                        </Button>
                    </StackPane>

                    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="typing-area">
                        <ProgressIndicator fx:id="aiProgressIndicator"
                                           prefWidth="18" prefHeight="18"
                                           visible="false" managed="false"/>
                        <Label fx:id="aiLoadingLabel"
                               text="AI đang tìm câu trả lời cho bạn..."
                               visible="false"
                               managed="false"
                               styleClass="ai-loading-label"/>
                        <Label fx:id="typingLabel" visible="false" managed="false" styleClass="typing-label"/>
                    </HBox>
                </VBox>
            </center>

            <!-- CONVERSATION ACTIONS -->
            <right>
                <VBox fx:id="chatActionsPanel"
                      prefWidth="190"
                      spacing="12"
                      styleClass="conversation-actions-panel">
                    <padding>
                        <Insets top="20" right="14" bottom="20" left="14"/>
                    </padding>
                    <Button fx:id="groupMembersButton"
                            text="Thành viên nhóm"
                            maxWidth="Infinity"
                            onAction="#handleShowGroupMembers"
                            styleClass="conversation-action-button">
                        <graphic>
                            <FontIcon iconLiteral="fa-users"
                                      styleClass="btn-icon"/>
                        </graphic>
                    </Button>
                    <Button text="File đã gửi"
                            maxWidth="Infinity"
                            onAction="#handleShowSentFiles"
                            styleClass="conversation-action-button">
                        <graphic>
                            <FontIcon iconLiteral="fa-paperclip"
                                      styleClass="btn-icon"/>
                        </graphic>
                    </Button>
                    <Button text="Link đã gửi"
                            maxWidth="Infinity"
                            onAction="#handleShowSentLinks"
                            styleClass="conversation-action-button">
                        <graphic>
                            <FontIcon iconLiteral="fa-link"
                                      styleClass="btn-icon"/>
                        </graphic>
                    </Button>
                </VBox>
            </right>

            <!-- INPUT BAR -->
            <bottom>
                <VBox fx:id="inputArea" styleClass="input-area">

                    <!-- FILE PREVIEW -->
                    <HBox fx:id="filePreviewBox"
                          spacing="12"
                          alignment="CENTER_LEFT"
                          visible="false"
                          managed="false"
                          styleClass="file-preview">
                        <padding>
                            <Insets top="10" right="18" bottom="10" left="18"/>
                        </padding>

                        <StackPane styleClass="file-preview-icon-wrap">
                            <FontIcon iconLiteral="fa-file-o"
                                      styleClass="file-preview-icon"/>
                        </StackPane>

                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                            <Label fx:id="fileNameLabel"
                                   text=""
                                   styleClass="file-preview-name"/>
                            <Label fx:id="fileSizeLabel"
                                   text=""
                                   styleClass="file-preview-size"/>
                        </VBox>

                        <Button onAction="#handleRemoveFile"
                                styleClass="icon-only-button">
                            <graphic>
                                <FontIcon iconLiteral="fa-times"
                                          styleClass="btn-icon"/>
                            </graphic>
                        </Button>
                    </HBox>

                    <!-- TOOLBAR -->
                    <HBox alignment="CENTER_LEFT"
                          spacing="10"
                          styleClass="input-toolbar">
                        <padding>
                            <Insets top="10" right="22" bottom="10" left="22"/>
                        </padding>

                        <Button text="Chọn file"
                                fx:id="attachButton"
                                onAction="#handleAttachFile"
                                styleClass="upload-button">
                            <graphic>
                                <FontIcon iconLiteral="fa-paperclip"
                                          styleClass="btn-icon"/>
                            </graphic>
                        </Button>
                    </HBox>

                    <!-- MESSAGE ROW -->
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <padding>
                            <Insets top="10" right="22" bottom="14" left="22"/>
                        </padding>

                        <TextField fx:id="messageInput"
                                   promptText="Nhập tin nhắn..."
                                   HBox.hgrow="ALWAYS"
                                   onAction="#handleSendMessage"
                                   styleClass="message-input"/>

                        <Button fx:id="sendButton"
                                onAction="#handleSendMessage"
                                styleClass="send-button">
                            <graphic>
                                <HBox alignment="CENTER" spacing="7">
                                    <Label text="Gửi"
                                           styleClass="send-label"/>
                                    <FontIcon iconLiteral="fa-paper-plane"
                                              styleClass="send-icon"/>
                                </HBox>
                            </graphic>
                        </Button>

                    </HBox>
                </VBox>
            </bottom>

        </BorderPane>
    </center>

</BorderPane>
