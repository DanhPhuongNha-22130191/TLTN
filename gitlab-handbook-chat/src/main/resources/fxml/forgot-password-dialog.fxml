<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="secretchat.auth.controller.ForgotPasswordController"
      stylesheets="@../css/dialog-common.css"
      styleClass="dialog-root"
      prefWidth="440">

    <HBox styleClass="dialog-header" alignment="CENTER_LEFT" spacing="12">
        <padding>
            <Insets top="20" right="24" bottom="20" left="24"/>
        </padding>

        <StackPane styleClass="dialog-icon-box">
            <FontIcon fx:id="resetIcon" styleClass="dialog-icon"/>
            <Label fx:id="fallbackIconLabel"
                   text="Mail"
                   visible="false"
                   managed="false"
                   styleClass="dialog-icon-fallback"/>
        </StackPane>

        <VBox spacing="2">
            <Label text="Quên mật khẩu" styleClass="dialog-title"/>
            <Label text="Nhận liên kết đặt lại mật khẩu qua email"
                   styleClass="dialog-caption"/>
        </VBox>
    </HBox>

    <VBox spacing="8" styleClass="dialog-body">
        <padding>
            <Insets top="24" right="24" bottom="20" left="24"/>
        </padding>

        <Label text="Email nội bộ" styleClass="field-label"/>
        <HBox fx:id="emailInputGroup"
              alignment="CENTER_LEFT"
              styleClass="email-input-group">
            <TextField fx:id="emailField"
                       promptText="Nhập tên đăng nhập"
                       styleClass="email-local-part"
                       HBox.hgrow="ALWAYS"/>
            <Label text="\@gitlab.handbook.local"
                   styleClass="email-domain-suffix"/>
        </HBox>
        <Label fx:id="emailError"
               visible="false"
               managed="false"
               styleClass="error-label"/>
        <Label fx:id="resultLabel"
               visible="false"
               managed="false"
               wrapText="true"
               styleClass="dialog-caption"/>
        <Hyperlink fx:id="webmailLink"
                   text="Mở Roundcube để kiểm tra email"
                   onAction="#handleOpenWebmail"
                   visible="false"
                   managed="false"
                   styleClass="webmail-link"/>
    </VBox>

    <HBox spacing="12" alignment="CENTER_RIGHT" styleClass="dialog-footer">
        <padding>
            <Insets top="18" right="24" bottom="22" left="24"/>
        </padding>

        <ProgressIndicator fx:id="loadingIndicator"
                           prefWidth="22"
                           prefHeight="22"
                           visible="false"
                           managed="false"/>
        <Button fx:id="cancelButton"
                text="Đóng"
                onAction="#handleCancel"
                styleClass="cancel-btn"/>
        <Button fx:id="sendButton"
                text="Gửi liên kết"
                onAction="#handleSend"
                defaultButton="true"
                styleClass="primary-btn"/>
    </HBox>
</VBox>
