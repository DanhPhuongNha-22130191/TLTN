<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="secretchat.auth.controller.MailboxCredentialsController"
      stylesheets="@../css/dialog-common.css"
      styleClass="dialog-root"
      prefWidth="500">

    <HBox styleClass="dialog-header" alignment="CENTER_LEFT" spacing="12">
        <padding>
            <Insets top="20" right="24" bottom="20" left="24"/>
        </padding>
        <StackPane styleClass="dialog-icon-box">
            <FontIcon iconLiteral="fa-envelope" styleClass="dialog-icon"/>
        </StackPane>
        <VBox spacing="2">
            <Label text="Tài khoản mail nội bộ" styleClass="dialog-title"/>
            <Label text="Thông tin này chỉ hiển thị một lần" styleClass="dialog-caption"/>
        </VBox>
    </HBox>

    <VBox spacing="10" styleClass="dialog-body">
        <padding>
            <Insets top="22" right="24" bottom="22" left="24"/>
        </padding>
        <Label text="Email" styleClass="field-label"/>
        <TextField fx:id="emailField"
                   editable="false"
                   styleClass="credential-value"/>
        <Label text="Mật khẩu mail" styleClass="field-label"/>
        <TextField fx:id="passwordField"
                   editable="false"
                   styleClass="credential-value"/>
        <Label text="Địa chỉ webmail" styleClass="field-label"/>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <TextField fx:id="webmailField"
                       editable="false"
                       onMouseClicked="#handleWebmailFieldClick"
                       styleClass="credential-value,webmail-value"
                       HBox.hgrow="ALWAYS"/>
            <Button text="Mở webmail"
                    onAction="#handleOpenWebmail"
                    styleClass="open-webmail-btn"/>
        </HBox>
        <Label text="Mật khẩu mail khác mật khẩu chat. Hãy lưu lại để đọc thư đặt lại mật khẩu."
               wrapText="true"
               styleClass="dialog-caption"/>
        <Label fx:id="copiedLabel"
               text="Đã sao chép thông tin."
               visible="false"
               managed="false"
               styleClass="credential-copied"/>
        <Label fx:id="openErrorLabel"
               visible="false"
               managed="false"
               wrapText="true"
               styleClass="error-label"/>
    </VBox>

    <HBox spacing="12" alignment="CENTER_RIGHT" styleClass="dialog-footer">
        <padding>
            <Insets top="18" right="24" bottom="22" left="24"/>
        </padding>
        <Button text="Sao chép"
                onAction="#handleCopy"
                styleClass="cancel-btn"/>
        <Button text="Tôi đã lưu"
                onAction="#handleClose"
                defaultButton="true"
                styleClass="primary-btn"/>
    </HBox>
</VBox>
